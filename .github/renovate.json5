{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "dependencyDashboard": true,
  "configMigration": true,
  "automerge": false,
  "timezone": "Asia/Ho_Chi_Minh",
  "schedule": [
    "before 5am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "branchPrefix": "automation/renovate/",
  "draftPR": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageLowerCase": "never",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "npm",
    "nuget",
    "pip-compile"
  ],
  "rangeStrategy": "pin",
  "constraints": {
    "python": "==3.14"
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/process\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest"
  },
  "prBodyTemplate": "<!-- engineering-process:pr-description:start -->\n## Summary\n\nRenovate proposes one locked dependency update for the reference product.\n\n{{{table}}}\n\n## Contract and scope\n\nDependency automation follows the repository-owned manifests and process authority pin.\n\n## Impact and risk\n\nThe complete candidate remains a draft until CI and independent review approve its exact checkpoint.\n\n## Verification\n\nProject checks and process adoption validation run against the fully materialized branch.\n\n## Independent review\n\nA separate reviewer must approve the exact verified checkpoint before merge.\n\n## Requirements and rules followed\n\n- [ ] **Scope and contract** — accepted scope is implemented without unapproved expansion. [status: pending]\n- [ ] **Verification evidence** — required current profiles pass on the published checkpoint. [status: pending]\n- [ ] **Independent review** — a separate reviewer approved the published checkpoint with no open required finding. [status: pending]\n<!-- engineering-process:pr-description:end -->",
  "packageRules": [
    {
      "description": "Adopt each published engineering-process release as a complete managed pull request.",
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": [
        "engineering-process"
      ],
      "enabled": true,
      "automerge": false,
      "groupName": "engineering-process",
      "groupSlug": "engineering-process",
      "schedule": [
        "at any time"
      ],
      "prPriority": 100,
      "commitMessageTopic": "engineering-process",
      "postUpgradeTasks": {
        "commands": [
          "python .process/adopt-process.py --project-root . --requirements-lock requirements/process.txt"
        ],
        "fileFilters": [
          ".agents/skills/**",
          ".github/PULL_REQUEST_TEMPLATE.md",
          ".process/adopt-process.py",
          ".process/automation.json",
          ".process/adopt-process-windows-job.py",
          ".process/adoption-migrations/**",
          ".process/process.lock",
          ".process/project.json",
          "AGENTS.md"
        ],
        "executionMode": "update",
        "installTools": {
          "python": {}
        }
      }
    },
    {
      "description": "Keep the approved SDK and Node baselines explicit.",
      "matchFileNames": [
        "global.json",
        ".nvmrc"
      ],
      "enabled": false
    },
    {
      "description": "Do not update bundled npm independently from the Node baseline.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "enabled": false
    },
    {
      "description": "Group .NET package updates.",
      "matchManagers": [
        "nuget"
      ],
      "groupName": ".NET packages",
      "groupSlug": "dotnet-packages"
    },
    {
      "description": "Group frontend tooling updates.",
      "matchManagers": [
        "npm"
      ],
      "groupName": "frontend dependencies",
      "groupSlug": "frontend-dependencies"
    },
    {
      "description": "Group container digest updates.",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "container images",
      "groupSlug": "container-images"
    },
    {
      "description": "Require dashboard approval before proposing major updates.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
