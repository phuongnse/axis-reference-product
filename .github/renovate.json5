{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "automation/renovate/",
  "commitMessageLowerCase": "never",
  "configMigration": true,
  "constraints": {
    "python": "==3.14"
  },
  "dependencyDashboard": true,
  "draftPR": true,
  "enabled": true,
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "npm",
    "nuget",
    "pip-compile"
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>phuongnse/engineering-process//templates/renovate#c292559166faeda7715dedab3d28c08afdccc64c"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "packageRules": [
    {
      "commitMessageTopic": "engineering-process",
      "description": "Adopt each published engineering-process release as a complete managed pull request.",
      "draftPR": true,
      "enabled": true,
      "groupName": "engineering-process",
      "groupSlug": "engineering-process",
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": [
        "engineering-process"
      ],
      "postUpgradeTasks": {
        "commands": [
          "python .process/adopt-process.py --project-root . --requirements-lock requirements/process.txt"
        ],
        "executionMode": "update",
        "fileFilters": [
          ".agents/skills/**",
          ".github/PULL_REQUEST_TEMPLATE.md",
          ".process/adopt-process.py",
          ".process/automation.json",
          ".process/adopt-process-windows-job.py",
          ".process/adoption-migrations/**",
          ".process/process.lock",
          ".process/project.json",
          "AGENTS.md"
        ],
        "installTools": {
          "python": {}
        }
      },
      "prPriority": 100,
      "recreateWhen": "always",
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "Keep the approved SDK and Node baselines explicit.",
      "enabled": false,
      "matchFileNames": [
        "global.json",
        ".nvmrc"
      ]
    },
    {
      "description": "Do not update bundled npm independently from the Node baseline.",
      "enabled": false,
      "matchDepTypes": [
        "packageManager"
      ],
      "matchManagers": [
        "npm"
      ]
    },
    {
      "description": "Group .NET package updates.",
      "groupName": ".NET packages",
      "groupSlug": "dotnet-packages",
      "matchManagers": [
        "nuget"
      ]
    },
    {
      "description": "Group frontend tooling updates.",
      "groupName": "frontend dependencies",
      "groupSlug": "frontend-dependencies",
      "matchManagers": [
        "npm"
      ]
    },
    {
      "description": "Group container digest updates.",
      "groupName": "container images",
      "groupSlug": "container-images",
      "matchManagers": [
        "dockerfile"
      ]
    },
    {
      "dependencyDashboardApproval": true,
      "description": "Require dashboard approval before proposing major updates.",
      "matchPackageNames": [
        "!engineering-process"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/process\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "schedule": [
    "before 5am on monday"
  ],
  "semanticCommitScope": "deps",
  "semanticCommitType": "chore",
  "semanticCommits": "enabled",
  "timezone": "Asia/Ho_Chi_Minh",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest"
  }
}
