{
  "lifecycle": {
    "requiredProfiles": [
      "development",
      "review"
    ]
  },
  "profiles": {
    "development": [
      {
        "id": "frontend-unit",
        "run": [
          "node",
          "node_modules/vitest/vitest.mjs",
          "run",
          "--config",
          "vitest.config.ts"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "script-unit",
        "run": [
          "node",
          "--test",
          "scripts/architecture.test.mjs",
          "scripts/build-contract.test.mjs",
          "scripts/build-solution.test.mjs",
          "scripts/local-dev.test.mjs",
          "scripts/process-adoption.test.mjs"
        ],
        "timeoutSeconds": 900
      }
    ],
    "review": [
      {
        "id": "generate-api",
        "run": [
          "node",
          "node_modules/@hey-api/openapi-ts/bin/run.js"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "typecheck",
        "run": [
          "node",
          "node_modules/typescript/bin/tsc",
          "--noEmit"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "frontend-build",
        "run": [
          "node",
          "node_modules/vite/bin/vite.js",
          "build"
        ],
        "timeoutSeconds": 900
      },
      {
        "id": "dotnet-test",
        "run": [
          "dotnet",
          "test",
          "server/Axis.ReferenceProduct.Bff.Tests/Axis.ReferenceProduct.Bff.Tests.csproj",
          "--no-restore",
          "--disable-build-servers"
        ],
        "timeoutSeconds": 1800
      },
      {
        "id": "production-image",
        "run": [
          "docker",
          "build",
          "--tag",
          "axis-reference-product:process-review",
          "."
        ],
        "timeoutSeconds": 1800
      }
    ]
  },
  "project": "axis-reference-product",
  "schemaVersion": 5
}
